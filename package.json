{
  "name": "klinikutamasami",
  "version": "1.0.0",
  "description": "Website Klinik Utama SAMI, Sukabumi",
  "scripts": {
    "build": "npm run build:css && npm run build:js",
    "build:css": "tailwindcss -i ./styles.css -o ./assets/site.css --minify",
    "build:js": "node scripts/build-js.cjs",
    "build:vercel": "npm run build && node scripts/prepare-vercel.cjs",
    "dev": "npm run build:js && node scripts/serve.cjs",
    "format": "prettier --write index.html styles.css scripts/site.js tailwind.config.cjs",
    "pretest": "npm run build:js",
    "test": "playwright test"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "esbuild": "^0.28.2",
    "linkedom": "^0.18.15",
    "prettier": "^3.10.1",
    "tailwindcss": "^3.4.19"
  },
  "private": true,
  "dependencies": {
    "motion": "^14.14.0"
  }
}
